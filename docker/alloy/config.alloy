logging {
  level = "info"
}

prometheus.exporter "metrics" {
}

prometheus.scrape "newsfeed_api" {
  targets = [
    {
      __address__ = "host.docker.internal:8080",
      __metrics_path__ = "/actuator/prometheus",
    },
  ]

  scrape_interval = "5s"

  forward_to = [
    prometheus.exporter.metrics.receiver,
  ]
}
